{
  "source_label": "meu-relatorio.md",
  "bug_heading_pattern": "^####\\s+(BUG-\\d{8}-\\d{2})\\s+—\\s+(.*)$",
  "severity_pattern": "\\*\\*Severidade:\\*\\*\\s*(\\d)",
  "base_tags": ["meu-produto"],
  "default_tag": "meu-produto",
  "transversal_tag": "transversal",
  "heading_tag_rules": [
    { "pattern": "^##\\s+2\\.", "tag": "padrao-geral", "transversal": true },
    { "pattern": "^###\\s+3\\.1\\b", "tag": "modulo-a" },
    { "pattern": "^###\\s+3\\.2\\b", "tag": "modulo-b" },
    { "pattern": "^##\\s+" }
  ],
  "fallback_tag_by_keyword": [
    { "keyword": "Módulo A", "tag": "modulo-a" },
    { "keyword": "Módulo B", "tag": "modulo-b" }
  ]
}
